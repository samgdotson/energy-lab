# Midwest24k month-long DC-OPF workflow.
#
#   snakemake --cores 8 --resources mem_mb=24000        # full run
#   snakemake -n                                       # dry run
#   snakemake results/2015-08/days/2015-08-01/status.json --cores 4   # one day
#
# Run from this directory with the Midwest24k conda env active. See LOGBOOK.md.

import calendar
import sys

configfile: "config/config.yaml"

PY = f'"{sys.executable}"'
YEAR = config["analysis"]["year"]
MONTH = config["analysis"]["month"]
YM = f"{YEAR}-{MONTH:02d}"
DAYS = [f"{YM}-{d:02d}" for d in range(1, calendar.monthrange(YEAR, MONTH)[1] + 1)]
WIND = config["renewables"]["wind"]

wildcard_constraints:
    ym=r"\d{4}-\d{2}",
    day=r"\d{4}-\d{2}-\d{2}",
    year=r"\d{4}",


rule all:
    input:
        f"results/{YM}/summary/report.md",


rule build_network:
    input:
        case=config["case"]["matpower"],
        bus_meta=config["case"]["bus_meta"],
        sub_meta=config["case"]["substation_meta"],
    output:
        network="resources/base_network.nc",
        stats="resources/base_network_stats.json",
    log:
        "logs/build_network.log",
    shell:
        "{PY} scripts/build_network.py --case {input.case} --bus-meta {input.bus_meta} "
        "--sub-meta {input.sub_meta} --out {output.network} --stats {output.stats} > {log} 2>&1"


rule retrieve_eia930:
    output:
        manifest="resources/eia930/manifest_{year}.json",
    params:
        url=lambda w: config["load"]["eia930"]["url"],  # contains {year}/{half} for the script
    log:
        "logs/retrieve_eia930_{year}.log",
    shell:
        '{PY} scripts/retrieve_eia930.py --year {wildcards.year} --url "{params.url}" '
        "--out-dir resources/eia930 --manifest {output.manifest} > {log} 2>&1"


rule build_load_profiles:
    input:
        config="config/config.yaml",
        manifest="resources/eia930/manifest_{year}.json",
        user=list((config["load"].get("user_profiles") or {}).values()),
    output:
        profiles="resources/load_profiles_{year}.csv",
        sources="resources/load_profile_sources_{year}.json",
    log:
        "logs/build_load_profiles_{year}.log",
    shell:
        "{PY} scripts/build_load_profiles.py --config {input.config} --manifest {input.manifest} "
        "--out {output.profiles} --sources {output.sources} > {log} 2>&1"


rule retrieve_cutout:
    output:
        "resources/cutout_{ym}.nc",
    params:
        bounds=" ".join(map(str, WIND["cutout_bounds"])),
        year=lambda w: w.ym[:4],
        month=lambda w: int(w.ym[5:]),
    log:
        "logs/retrieve_cutout_{ym}.log",
    shell:
        "{PY} scripts/retrieve_cutout.py --year {params.year} --month {params.month} "
        "--bounds {params.bounds} --out {output} > {log} 2>&1"


def wind_inputs(w):
    inputs = {"config": "config/config.yaml", "network": "resources/base_network.nc"}
    if WIND["source"] == "atlite":
        inputs["cutout"] = f"resources/cutout_{w.ym}.nc"
    elif WIND["source"] == "csv":
        inputs["csv"] = WIND["csv"]
    return inputs


rule build_wind_profiles:
    input:
        unpack(wind_inputs),
    output:
        "resources/wind_cf_{ym}.csv",
    params:
        cutout=lambda w, input: f"--cutout {input.cutout}" if "cutout" in input.keys() else "",
    log:
        "logs/build_wind_profiles_{ym}.log",
    shell:
        "{PY} scripts/build_wind_profiles.py --config {input.config} --network {input.network} "
        "{params.cutout} --out {output} > {log} 2>&1"


rule prepare_network:
    input:
        config="config/config.yaml",
        network="resources/base_network.nc",
        load=lambda w: f"resources/load_profiles_{w.ym[:4]}.csv",
        wind="resources/wind_cf_{ym}.csv",
    output:
        network="resources/network_{ym}.nc",
        stats="resources/network_{ym}_stats.json",
    log:
        "logs/prepare_network_{ym}.log",
    shell:
        "{PY} scripts/prepare_network.py --config {input.config} --network {input.network} "
        "--load-profiles {input.load} --wind-cf {input.wind} --out {output.network} "
        "--stats {output.stats} > {log} 2>&1"


rule solve_day:
    input:
        config="config/config.yaml",
        network="resources/network_{ym}.nc",
    output:
        status="results/{ym}/days/{day}/status.json",
        gen_p="results/{ym}/days/{day}/gen_p.parquet",
        lmp="results/{ym}/days/{day}/lmp.parquet",
        loading="results/{ym}/days/{day}/branch_loading.parquet",
    threads: config["solving"].get("threads_per_day", 2)
    resources:
        mem_mb=config["solving"].get("mem_mb_per_day", 8000),
    log:
        "logs/solve_day/{ym}/{day}.log",
    shell:
        "{PY} scripts/solve_day.py --config {input.config} --network {input.network} "
        "--day {wildcards.day} --outdir results/{wildcards.ym}/days/{wildcards.day} > {log} 2>&1"


rule summarize:
    input:
        network="resources/network_{ym}.nc",
        status=lambda w: expand("results/{ym}/days/{day}/status.json", ym=w.ym,
                                day=[d for d in DAYS if d.startswith(w.ym)]),
        load_sources=lambda w: f"resources/load_profile_sources_{w.ym[:4]}.json",
    output:
        report="results/{ym}/summary/report.md",
    log:
        "logs/summarize_{ym}.log",
    shell:
        "{PY} scripts/summarize.py --network {input.network} --days-dir results/{wildcards.ym}/days "
        "--load-sources {input.load_sources} --outdir results/{wildcards.ym}/summary > {log} 2>&1"
